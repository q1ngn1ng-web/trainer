# ---- 模型服务（必需）----
# 任何兼容 OpenAI /chat/completions 的服务都行；默认 DeepSeek，申请地址 https://platform.deepseek.com/
# 留空也能启动：依赖模型的功能会走降级路径（目标澄清变表单、出题退回通用问法、主观题不作判定）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 运行模式 ----
# 1 = 必须登录（默认；对外提供访问时务必保持）
# 0 = 早期遗留的免登录模式，目前新建训练会失败，不建议使用
TRAINER_AUTH=1
# 用 HTTPS 部署时设为 1
TRAINER_COOKIE_SECURE=0

# ---- 存储 ----
# SQLite 数据库路径
DB_PATH=./data/trainer.db

# ---- 以下为早期遗留，随 retire-legacy-v1 一并移除 ----
# 一代界面（Streamlit）的落盘目录与端口
TRAINING_ROOT=./
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
# 轻语义用途路由到的便宜小模型（目前没有现役的轻语义用途）
# LLM_LIGHT_MODEL=qwen-flash
